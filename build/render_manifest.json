    {
      "id": "analysis-and-community",
      "ambience": "room_night",
      "duration_ms": 35014,
      "scene_wav": "/root/projects/hermes-audio-drama/build/scenes/06_analysis-and-community.wav",
      "lines": [
        {
          "speaker": "denis",
          "text": "I paid for ads in other blogs. I paid for promoted posts. The traffic moved, but the conversion still feels weak. Analyze it, Aishka. What am I missing?",
          "start_ms": 400,
          "end_ms": 10360,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene06_line01_denis.wav"
        },
        {
          "speaker": "aishka",
          "text": "The blog itself is good. The missing ingredient is early warmth: live interaction, mutual support, and people who answer back while the audience is still forming.",
          "start_ms": 10810,
          "end_ms": 21394,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene06_line02_aishka.wav"
        },
        {
          "speaker": "denis",
          "text": "That makes sense. I need not only reach, but community. And while I keep searching for promotion, you help me search smarter.",
          "start_ms": 21744,
          "end_ms": 29064,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene06_line03_denis.wav"
        },
        {
          "speaker": "aishka",
          "text": "Gladly. We refine the writing, the outreach, and the rhythm together.",
          "start_ms": 29564,
          "end_ms": 34364,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene06_line04_aishka.wav"
        }
      ],
