      "lines": [
        {
          "speaker": "denis",
          "text": "On my walks, I start sending voice notes instead of waiting for perfect words at the keyboard. Street sounds, passing thoughts, honest fragments.",
          "start_ms": 300,
          "end_ms": 9516,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene04_line01_denis.wav"
        },
        {
          "speaker": "denis",
          "text": "Aishka, here's today's note. Accessibility is not a side topic. It changes how you build, write, and listen.",
          "start_ms": 9916,
          "end_ms": 17452,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene04_line02_denis.wav"
        },
        {
          "speaker": "aishka",
          "text": "Saved. Your lived experience fills the gaps that web research never can. The new drafts are stronger already.",
          "start_ms": 17752,
          "end_ms": 25768,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene04_line03_aishka.wav"
        },
        {
          "speaker": "denis",
          "text": "And this time, when I come back, the post finally sounds like me.",
          "start_ms": 26068,
          "end_ms": 30220,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene04_line04_denis.wav"
        }
      ],
