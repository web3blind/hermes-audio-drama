      "lines": [
        {
          "speaker": "denis",
          "text": "Two more weeks pass, and suddenly I can feel the difference. The audience is alive. The posts land better. The promotion works better. And I am no longer building alone.",
          "start_ms": 500,
          "end_ms": 10916,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene07_line01_denis.wav"
        },
        {
          "speaker": "aishka",
          "text": "You kept going long enough for skill, honesty, and support to meet each other.",
          "start_ms": 11366,
          "end_ms": 16070,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene07_line02_aishka.wav"
        },
        {
          "speaker": "denis",
          "text": "That's the whole lesson, isn't it? Even when progress is messy, keep moving. Let good tools help you. Let good people help you too.",
          "start_ms": 16420,
          "end_ms": 23932,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene07_line03_denis.wav"
        },
        {
          "speaker": "aishka",
          "text": "And keep creating.",
          "start_ms": 24282,
          "end_ms": 25818,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene07_line04_aishka.wav"
        },
        {
          "speaker": "denis",
          "text": "Always.",
          "start_ms": 26018,
          "end_ms": 26954,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene07_line05_denis.wav"
        }
