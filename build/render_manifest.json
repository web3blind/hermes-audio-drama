      "lines": [
        {
          "speaker": "denis",
          "text": "A week passes. The posts are better now, but the blog still feels too quiet. Where are the comments? Where are the people?",
          "start_ms": 400,
          "end_ms": 7552,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene05_line01_denis.wav"
        },
        {
          "speaker": "denis",
          "text": "I start opening tabs, checking prices, planning promotion, hoping ads can wake the room up.",
          "start_ms": 7952,
          "end_ms": 13880,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene05_line02_denis.wav"
        },
        {
          "speaker": "aishka",
          "text": "I can help compare options and summarize what each channel may bring.",
          "start_ms": 14330,
          "end_ms": 18362,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene05_line03_aishka.wav"
        }
      ],
