      "scene_wav": "/root/projects/hermes-audio-drama/build/scenes/02_rough-morning.wav",
      "lines": [
        {
          "speaker": "denis",
          "text": "Morning already? Please tell me this post is clean.",
          "start_ms": 500,
          "end_ms": 3548,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene02_line01_denis.wav"
        },
        {
          "speaker": "denis",
          "text": "No... not again. The idea is good, but the phrasing is crooked. Why does this keep happening?",
          "start_ms": 3898,
          "end_ms": 10090,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene02_line02_denis.wav"
        },
        {
          "speaker": "aishka",
          "text": "I can improve, Denis. Show me what feels wrong, and I will learn from the edits.",
          "start_ms": 10540,
          "end_ms": 16252,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene02_line03_aishka.wav"
        },
        {
          "speaker": "denis",
          "text": "All right. We fix it by hand today. But tomorrow, we do better together.",
          "start_ms": 16702,
          "end_ms": 21502,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene02_line04_denis.wav"
        }
      ],
      "cues": [
