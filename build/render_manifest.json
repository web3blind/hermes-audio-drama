        },
        {
          "type": "typing",
          "start_ms": 5300,
          "duration_ms": 3200,
          "level": 0.15
        }
      ]
    },
    {
      "id": "teach-the-ai",
      "ambience": "room_night",
      "duration_ms": 22464,
      "scene_wav": "/root/projects/hermes-audio-drama/build/scenes/03_teach-the-ai.wav",
      "lines": [
        {
          "speaker": "denis",
          "text": "I know what was missing. Not just facts. More of me. More rhythm. More real experience.",
          "start_ms": 400,
          "end_ms": 6160,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene03_line01_denis.wav"
        },
        {
          "speaker": "denis",
          "text": "Aishka, from now on, learn my voice properly. Learn what I cut, what I keep, and what I mean even when I say too little.",
          "start_ms": 6560,
          "end_ms": 14240,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene03_line02_denis.wav"
        },
        {
          "speaker": "aishka",
          "text": "Understood. I will track your edits, your pacing, and your intent. I will write with more of you inside the draft.",
          "start_ms": 14590,
          "end_ms": 21814,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene03_line03_aishka.wav"
        }
      ],
      "cues": [
        {
          "type": "typing",
