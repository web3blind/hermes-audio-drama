        {
          "speaker": "denis",
          "text": "April seventeenth, twenty twenty-six. Another late night, another post, another chance to get it right. Aishka, are you with me?",
          "start_ms": 500,
          "end_ms": 8180,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene01_line01_denis.wav"
        },
        {
          "speaker": "aishka",
          "text": "Always. I am searching for sources now. I found relevant material. I am shaping the post in your style. Editing. Self-checking. Publishing. Done.",
          "start_ms": 8630,
          "end_ms": 20342,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene01_line02_aishka.wav"
        },
        {
          "speaker": "denis",
          "text": "Good. Then let's see what we wake up to.",
          "start_ms": 20842,
          "end_ms": 23290,
          "file": "/root/projects/hermes-audio-drama/build/lines/scene01_line03_denis.wav"
        }
